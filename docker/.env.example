# Copy to docker/.env before starting the stack. Do not commit docker/.env.

# Public hostname and published ports. `localhost` is correct for a local
# Docker run. Use a DNS name (without a scheme) with docker-compose.tls.yml.
APP_HOST=localhost
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL is private to Docker and is not published on the host. Use a long,
# URL-safe password (letters, digits, hyphen, underscore) because it becomes
# part of DATABASE_URL.
POSTGRES_DB=prism
POSTGRES_USER=prism
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required only for the HTTPS overlay and a real public hostname.
LETSENCRYPT_EMAIL=admin@example.com

# The API starts without a Gemini key, but generation returns 503 until set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional accounts, invitations, and object storage.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=invites@example.com
# DO_SPACES_ACCESS_KEY=
# DO_SPACES_SECRET_KEY=
# DO_SPACES_REGION=
# DO_SPACES_BUCKET=
# DO_SPACES_ENDPOINT=

# Usually derived from APP_HOST by Compose. Override only when the public URL
# differs from that hostname (for example when HTTP_PORT is not 80).
# APP_ORIGIN=http://localhost
# ALLOWED_ORIGINS=http://localhost

# Existing-Traefik deployment (`docker-compose.external.yml`). These defaults
# match the Neptune deployment; change the entrypoint/resolver names if the
# external proxy uses different ones.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
